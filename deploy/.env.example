# UNO VPS konfigūracija. Kopija: /opt/uno/.env (chmod 600). NIEKADA nedėti į git.
# Reikšmes be kabučių ir be tarpų aplink "=". Pakeitus: docker compose ... up -d (perkuria paveiktus konteinerius).

# ======================= Būtina =======================
# Domenas, kurio DNS A įrašas rodo į VPS IP (be https://)
DOMAIN=uno.example.lt
# El. paštas Let's Encrypt įspėjimams
ACME_EMAIL=paulius@example.lt
# Postgres slaptažodis (naudojamas ir URL: tik raidės/skaičiai). install.sh sugeneruoja pats: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_AUTO

# ======================= UNO programa =======================
# 1 = rodyti apskaitos skiltį /apskaita (joje yra „Importuoti iš pašto“ ir pašto sąskaitų sąrašas).
UNO_DEMO=1
# 1 = /apskaita ir jos API tik su prisijungimu. VPS / gamyboje PRIVALOMA 1 (0 = atviras vietinis demo be prisijungimo).
# Su 1: UNO sesija tik UNO įmonės (company_id=1), accountant/admin skaito ir rašo (su CSRF), manager tik skaito;
# personalo sesija tik direktorius / hr.
UNO_DEMO_AUTH=1
# GAMA patikros įmonių ID sąrašas (kableliais), kurioms leidžiama /app „GAMA patikra“
UNO_GAMA_COMPANIES=1
# GAMA SQL snapshot komanda (JSON masyvas arba eilutė). Tuščia = numatytoji (Windows PowerShell skriptas, VPS neveikia).
# Kol GAMA SQL prieiga iš VPS neišspręsta, palikti tuščią; žr. DIEGIMAS_VPS.md „Atviri klausimai“.
UNO_GAMA_SNAPSHOT_CMD=

# ======================= Paštas (sąskaitos iš <SASKAITU_PASTAS>@gmail.com) =======================
# Gmail programos slaptažodis (16 simbolių, be tarpų): myaccount.google.com/apppasswords
UNO_IMAP_USER=<SASKAITU_PASTAS>@gmail.com
UNO_IMAP_PASSWORD=
UNO_IMAP_HOST=imap.gmail.com
UNO_IMAP_PORT=993
# Gmail paieškos papildymas (nebūtina). Tikrai sąskaitų dėžutei palikti tuščią.
UNO_IMAP_QUERY=
# Sąskaitos, siunčiamos tik kaip nuoroda: sekami tik https nuorodos į šiuos domenus (kableliais; numatyta agnum.lt).
# Kitų domenų nuorodos ignoruojamos. Tuščia = numatytasis.
UNO_INVOICE_LINK_DOMAINS=agnum.lt
# 1 = AI užpildo laukus, kurių nerado paprastas parseris. 0 = išjungti AI (nieko nesiunčiama į išorę)
UNO_MAIL_AI=1
# Kas kiek minučių pašto procesas (worker) tikrina dėžutę
MAIL_POLL_MINUTES=15

# ======================= AI laukų ištraukimas =======================
# vertex    = Google Vertex AI Gemini (numatyta VPS; reikia GOOGLE_SA_KEY_B64 su roles/aiplatform.user)
# anthropic = Anthropic Messages API (reikia ANTHROPIC_API_KEY)
# cli       = vietinis `claude -p` (VPS neįdiegtas; tinka tik kūrimo kompiuteriui)
# Nemokamas Gemini API (AI Studio raktas) NEDUODAMAS: nemokamame lygyje Google gali naudoti užklausas
# produkto gerinimui ir nėra DPA. Vertex AI taikomos Google Cloud sutarties sąlygos.
UNO_AI_PROVIDER=vertex
# Modelis. Tuščia = numatytasis: vertex gemini-3.8-flash (GA), anthropic claude-sonnet-5-5
UNO_AI_MODEL=
# Vertex vieta. Tuščia = eu (daugiaregionis, ES apdorojimas). Kiti: us, global, arba regionas (jei modelis jame yra)
UNO_AI_LOCATION=
ANTHROPIC_API_KEY=

# ======================= Google Cloud (Vertex AI ir Maršrutai) =======================
# Service account JSON, užkoduotas base64 (viena eilutė): base64 -w0 key.json
# Rolės: roles/aiplatform.user (Vertex) ir roles/routeoptimization.editor (Maršrutai)
GOOGLE_SA_KEY_B64=
# GCP projektas. Tuščia: Vertex imamas iš rakto project_id, Maršrutai numatytas marsrutai-digimuza
GOOGLE_CLOUD_PROJECT=

# ======================= Maršrutai (kolegos programa) =======================
# Optimizavimo užklausos riba, ms (Google Route Optimization)
MARSRUTAI_API_TIMEOUT_MS=120000
# off = nekviesti viešo OSRM kelio geometrijai (Mock režime)
MARSRUTAI_ROAD_GEOMETRY=on
# Kolegos repo kelias compose atžvilgiu (numatyta ../../marsrutai = /opt/uno/marsrutai)
MARSRUTAI_DIR=../../marsrutai

# ======================= Personalas (HR) ir apžvalga =======================
# 0 gamyboje. 1 = demo prisijungimas pagal personą be el. pašto (tik demonstracijai!)
HR_DEMO=0
# Prisijungimo nuorodų ir parašo laiškai per Resend: abu laukai privalomi, kad laiškas išeitų.
# HR_DEMO=0: prisijungimo nuoroda NIEKUR nerodoma ir nesaugoma (nei outbox, nei DB), tik laiške; be Resend vartotojas neprisijungs.
RESEND_API_KEY=
# Gavėjai, kuriems leidžiama siųsti (kableliais). Kitiems laiškas lieka tik sistemos dėžutėje
HR_MAIL_ALLOWLIST=
HR_MAIL_FROM=Demo įmonė <onboarding@resend.dev>
# Dokobit postback paslaptis (X-Postback-Secret); tuščia = postback atmetamas. install.sh sugeneruoja
HR_POSTBACK_SECRET=CHANGE_ME_AUTO
# demo | dokobit (dokobit dar nerealizuota)
HR_SIGNING=demo

# ======================= Atsarginės kopijos =======================
# Vieta VPS diske (bind mount). Kopijuoti už VPS ribų: žr. backup-restore.md
BACKUP_DIR=/opt/uno/backups
# Kiek kopijų laikyti (kiekvieno tipo)
BACKUP_KEEP=14
# Valanda UTC, kada daroma kasdienė kopija
BACKUP_HOUR=3

# ======================= Sudėtiniai (nustato docker-compose.yml, čia nekeisti) =======================
# Žemiau išvardyti kintamieji išvedami automatiškai:
#   HR_DATABASE_URL / DATABASE_URL  = postgresql://uno:<POSTGRES_PASSWORD>@postgres:5432/{uno|marsrutai}
#   HR_BASE_URL                     = https://<DOMAIN>
#   HR_SECURE_COOKIE=1, UNO_SECURE_COOKIE=1, UNO_DB=/data/uno.db, UNO_MAIL_DIR=/data/mail,
#   UNO_SUPPLIERS_FILE=/data/suppliers.json, UNO_GAMA_DATA_DIR=/data/gama
#   MARSRUTAI_BASE=/marsrutai/, PORT=8787 (Maršrutai)

# Bendras slaptas raktas tarp app/worker ir `linkfetch` (naršyklės konteinerio). install.sh sugeneruoja automatiškai.
LINKFETCH_TOKEN=CHANGE_ME_AUTO
